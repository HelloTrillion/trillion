# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Tauri
apps/desktop/target/

# Local state — never commit.
# Runtime state lives in ~/.trillion/ (see PER-2), not in a checkout; these
# anchored rules catch the case where someone runs from a source tree.
.env
.env.*
*.db
*.db-journal
*.sqlite3
/data/
/persona/USER.md
/persona/IDENTITY.md
/memory/

# Models (large; fetched by the installer)
models/*.onnx

# OS / editors
.DS_Store
.idea/
.vscode/

# Coverage
.coverage
.coverage.*
htmlcov/

# Playwright: what a run of the Galaxy snapshots leaves behind
test-results/
playwright-report/

# A distribution's own Google OAuth client (connectors/google/config.py). Never committed.
src/trillion/connectors/google/google_client.json
