<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A signed build runs with the hardened runtime, which notarizing requires. Under
       it, the microphone needs this entitlement as well as NSMicrophoneUsageDescription
       in Info.plist. An unsigned build ignores this file. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
